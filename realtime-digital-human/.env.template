# Copy this file to .env and fill real values on the deployment server.

# LLM provider: gongan, rag, chatgpt_oss, ratubrain, aliyun, iflytek
LLM_PROVIDER=gongan
LISTEN_PORT=8010

# OpenAI-compatible LLM, used by LLM_PROVIDER=gongan
BASE_URL=https://your-llm-endpoint.example.com/v1
API_KEY=your-api-key
MODEL_NAME=your-model-name

# Iflytek AIUI, used by LLM_PROVIDER=iflytek
IFLYTEK_WS_URL=wss://aiui.xf-yun.com/v3/aiint/sos
IFLYTEK_APPID=your-iflytek-appid
IFLYTEK_API_KEY=your-iflytek-api-key
IFLYTEK_API_SECRET=your-iflytek-api-secret
IFLYTEK_SCENE=main_box
IFLYTEK_VCN=x5_lingxiaoyue_flow
IFLYTEK_TIMEOUT=30
IFLYTEK_TTS_VCN=xiaoyan
IFLYTEK_TTS_FALLBACK_VCN=xiaoyan

# Aliyun DashScope, used by LLM_PROVIDER=aliyun
DASHSCOPE_API_KEY=your-dashscope-api-key

# RAG service, used by LLM_PROVIDER=rag
LLM_SERVICE=http://your-rag-service:8002
BING_SUBSCRIPTION_KEY=your-bing-subscription-key
BING_SEARCH_URL=https://api.bing.microsoft.com/v7.0/search

# Ratubrain, used by LLM_PROVIDER=ratubrain
RATUBRAIN_BASE_URL=https://your-ratubrain-endpoint.example.com/api/ai/chat/stream/start_chat/get
RATUBRAIN_API_KEY=your-ratubrain-api-key

# TTS service
TTS_TYPE=sparktts
TTS_SERVER=http://your-tts-service:8779
TTS_SERVICE=http://your-tts-service:8779

# Performance logs and low-latency segmented TTS
PERF_LOG_ENABLED=1
PERF_ASR_EVERY_N=50
LLM_STREAM_TTS_ENABLED=1
LLM_STREAM_TTS_FIRST_CHARS=10
LLM_STREAM_TTS_MIN_CHARS=10
LLM_STREAM_TTS_MAX_CHARS=24

# Optional upload API / MinIO
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=your-bucket
MINIO_PUBLIC_BASE_URL=https://your-public-minio-host/your-bucket-root
MINIO_SECURE=false
